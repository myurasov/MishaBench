#
# MishaBench -- single-entry helper for both the bench CLI and the
# project's dev workflow. The first argument selects the mode:
#
#   ./mishabench install [--force] [--gpu]   # ensure venv + deps (idempotent)
#   ./mishabench test    [args...]           # run pytest (auto-installs first)
#   ./mishabench lint    [args...]           # run ruff check (auto-installs first)
#   ./mishabench fmt                         # run ruff check --fix + ruff format
#   ./mishabench shell                       # drop into a venv-activated subshell
#   ./mishabench clean                       # remove .venv + lint/test caches
#   ./mishabench help                        # show this help text
#
# Anything else is forwarded to the MishaBench Python CLI:
#
#   ./mishabench info                        # print system probe (cpu, ram, gpu, cuda)
#   ./mishabench list                        # list every benchmark
#   ./mishabench run                         # run all suites locally
#   ./mishabench run --quick                 # ~5-min smoke version of every suite
#   ./mishabench run --suites data,cv        # subset
#   ./mishabench run --remote <ssh-host>     # rsync + run on remote, fetch report back
#   ./mishabench report <results-dir>        # rebuild HTML from a results directory
#
# Auto-install: every subcommand bootstraps the venv on first use.
# Subsequent runs skip the bootstrap unless pyproject.toml is newer
# than the install stamp (or you pass --force to install).

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"

PYTHON_VERSION="${MISHABENCH_PYTHON:-3.12}"
VENV_DIR=".venv"
INSTALL_STAMP="$VENV_DIR/.mishabench-installed"
GPU_STAMP="$VENV_DIR/.mishabench-gpu"

color() { printf "\033[%sm%s\033[0m" "$1" "$2"; }
log()   { color "1;36" "[mishabench] "; echo "$@"; }
warn()  { color "1;33" "[mishabench] "; echo "$@" >&2; }
die()   { color "1;31" "[mishabench] "; echo "$@" >&2; exit 1; }

require_uv() {
  if ! command -v uv >/dev/null 2>&1; then
    die "uv is required (https://docs.astral.sh/uv/). Install with:
    curl -LsSf https://astral.sh/uv/install.sh | sh
or, on macOS, 'brew install uv'."
  fi
}

ensure_venv() {
  if [ ! -d "$VENV_DIR" ]; then
    log "creating $VENV_DIR (Python $PYTHON_VERSION via uv)"
    uv venv --python "$PYTHON_VERSION" "$VENV_DIR" >/dev/null
  fi
}

deps_ready() {
  [ -x "$VENV_DIR/bin/python" ] || return 1
  [ -x "$VENV_DIR/bin/pytest" ] || return 1
  [ -x "$VENV_DIR/bin/ruff" ] || return 1
  "$VENV_DIR/bin/python" -c "import typer, rich, yaml, numpy, pandas, polars, torch" >/dev/null 2>&1 || return 1
  # When the user opted into GPU extras (sticky stamp), also require
  # cudf + cupy. A `uv sync --extra dev` doesn't preserve out-of-band
  # `uv pip install` packages (cudf-cu12, cupy-cuda12x ship outside
  # the project's lockfile), so cudf can vanish silently after any
  # sync. Without this check, the wrapper would mistake a cudf-less
  # venv for "deps ready" and skip the gpu_extras_install step.
  if [ -f "$GPU_STAMP" ]; then
    "$VENV_DIR/bin/python" -c "import cudf, cupy" >/dev/null 2>&1 || return 1
  fi
}

gpu_extras_install() {
  log "installing gpu extras (cudf-cu12 + cupy-cuda12x from pypi.nvidia.com) -- live progress follows"
  if ! uv pip install --extra-index-url https://pypi.nvidia.com \
                      cudf-cu12 cupy-cuda12x; then
    warn "gpu extras failed to install; cudf/cupy benches will be skipped at run time"
    warn "(this is expected on non-Linux or non-CUDA hosts; remove $GPU_STAMP to drop the marker)"
    return 1
  fi
  return 0
}

sync_deps() {
  log "syncing dependencies (uv sync --extra dev) -- live progress follows"
  if uv sync --extra dev && deps_ready; then
    touch "$INSTALL_STAMP"
  else
    warn "dependency sync failed or incomplete; recreating $VENV_DIR and retrying"
    rm -rf "$VENV_DIR"
    ensure_venv
    uv sync --extra dev
    deps_ready || die "dependency sync finished but venv is incomplete; try ./mishabench clean && ./mishabench install"
    touch "$INSTALL_STAMP"
  fi

  # If the default torch wheel doesn't match the host's NVIDIA driver
  # (PyPI ships cu130 these days; older drivers need cu126 / cu118),
  # detect the mismatch and reinstall torch from the appropriate
  # PyTorch index. Honor MISHABENCH_TORCH_CUDA as an explicit override
  # ("auto", "cu118", "cu121", "cu126", "cu128", "cu130", "cpu").
  fix_torch_cuda_if_needed

  # GPU extras (RAPIDS) are installed out-of-band: cudf-cu12 / cupy-cuda12x
  # ship as nvidia-stub placeholders that fail metadata resolution on
  # macOS, so we keep them out of pyproject.toml (where `uv sync` would
  # try to resolve all extras) and install them directly into the venv
  # only when the user opts in via `./mishabench install --gpu`.
  if [ -f "$GPU_STAMP" ]; then
    gpu_extras_install || true
  fi
}

torch_cuda_works() {
  "$VENV_DIR/bin/python" -c \
    "import torch, sys; sys.exit(0 if torch.cuda.is_available() else 1)" \
    >/dev/null 2>&1
}

install_torch_index() {
  # Reinstall torch + torchvision from the given PyTorch wheel index
  # (e.g. https://download.pytorch.org/whl/cu126). Returns 0 on success.
  local cu="$1"
  local url="https://download.pytorch.org/whl/$cu"
  log "  reinstalling torch + torchvision from $url"
  uv pip install --index-url "$url" torch torchvision --reinstall && return 0
  warn "  --index-url install failed, retrying with --extra-index-url"
  uv pip install --extra-index-url "$url" torch torchvision --reinstall
}

fix_torch_cuda_if_needed() {
  local choice="${MISHABENCH_TORCH_CUDA:-auto}"

  if [ "$choice" = "cpu" ]; then
    log "MISHABENCH_TORCH_CUDA=cpu -- installing CPU-only torch"
    install_torch_index "cpu" || warn "CPU torch install failed; existing wheel left in place"
    return
  fi

  if [ "$choice" != "auto" ]; then
    log "MISHABENCH_TORCH_CUDA=$choice -- forcing torch wheel from $choice index"
    install_torch_index "$choice" || warn "torch reinstall from $choice failed"
    return
  fi

  # Auto: only act if there's an NVIDIA GPU but torch.cuda doesn't see it.
  command -v nvidia-smi >/dev/null 2>&1 || return 0
  if torch_cuda_works; then
    return 0
  fi

  local drv
  drv=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader,nounits 2>/dev/null \
         | head -1 | cut -d. -f1 | tr -d ' ')
  if [ -z "$drv" ]; then
    return 0
  fi

  log "torch.cuda unavailable; nvidia driver $drv detected -- selecting compatible torch wheel"
  local cu=""
  if [ "$drv" -ge 545 ]; then
    log "  driver $drv supports cu130 (default); skipping reinstall (mismatch likely elsewhere)"
    return 0
  elif [ "$drv" -ge 525 ]; then
    cu="cu126"
  elif [ "$drv" -ge 470 ]; then
    cu="cu118"
  else
    warn "  driver $drv too old for any current torch CUDA build; CUDA benches will skip"
    return 0
  fi
  install_torch_index "$cu" || warn "  torch reinstall failed; CUDA benches will skip"
  if torch_cuda_works; then
    log "  torch.cuda now sees the GPU"
  else
    warn "  torch.cuda still unavailable after reinstall; CUDA benches will skip"
  fi
}

ensure_deps() {
  local force="${1:-}"
  if [ "$force" = "--force" ] || \
     [ ! -f "$INSTALL_STAMP" ] || \
     [ "pyproject.toml" -nt "$INSTALL_STAMP" ] || \
     ! deps_ready; then
    sync_deps
  fi
}

bootstrap() {
  local force="${1:-}"
  require_uv
  ensure_venv
  ensure_deps "$force"
}

show_help() {
  # Print the comment block at the top of this script, stripping the
  # leading '# ' so it reads as plain text.
  sed -n '5,30p' "$0" | sed 's/^# \{0,1\}//'
}

run_cli() {
  bootstrap
  # If --gpu is passed to a LOCAL run (no --remote), treat it as an
  # implicit `install --gpu` for this venv. The Python CLI's --gpu
  # flag is otherwise only honoured by the --remote driver, so the
  # naive `./mishabench run --gpu` would silently do nothing about
  # cudf. With --remote present we leave the local venv alone -- the
  # remote side does its own install.
  has_gpu=""
  has_remote=""
  for a in "$@"; do
    case "$a" in
      --gpu)        has_gpu="1" ;;
      --remote|-r)  has_remote="1" ;;
    esac
  done
  if [ -n "$has_gpu" ] && [ -z "$has_remote" ]; then
    if [ ! -f "$GPU_STAMP" ]; then
      ensure_venv
      touch "$GPU_STAMP"
      log "--gpu requested for local run -- marking gpu extras sticky on this venv"
    fi
    if ! "$VENV_DIR/bin/python" -c "import cudf, cupy" >/dev/null 2>&1; then
      gpu_extras_install || true
    fi
  fi
  # PYTHONPATH=$HERE makes `src` importable as a package, so `python -m
  # src` resolves to src/__main__.py. We avoid editable installs (which
  # need a setuptools .pth shim that some cloud-synced filesystems mark
  # hidden, breaking Python 3.12.13+'s import machinery).
  PYTHONPATH="$HERE" exec "$VENV_DIR/bin/python" -m src "$@"
}

main() {
  if [ $# -eq 0 ]; then
    show_help
    echo
    bootstrap
    PYTHONPATH="$HERE" "$VENV_DIR/bin/python" -m src --help
    exit 0
  fi

  cmd="$1"

  case "$cmd" in
    install)
      shift
      # Parse args: --gpu sets the sticky stamp (so future syncs include
      # the gpu install step); --force forwards to bootstrap to force a
      # full reinstall even if the venv looks fresh.
      gpu_requested=""
      force_arg=""
      for a in "$@"; do
        case "$a" in
          --gpu)   gpu_requested="1" ;;
          --force) force_arg="--force" ;;
        esac
      done
      if [ -n "$gpu_requested" ]; then
        ensure_venv
        touch "$GPU_STAMP"
        log "gpu extras enabled (cudf-cu12 + cupy-cuda12x sticky on this venv)"
      fi
      bootstrap "$force_arg"
      # If --gpu was passed AND deps_ready already returned OK without
      # triggering sync_deps (so gpu_extras_install never ran in
      # sync_deps), force the gpu install here. Idempotent -- uv pip
      # install is fast when the packages are already present.
      if [ -n "$gpu_requested" ]; then
        if "$VENV_DIR/bin/python" -c "import cudf, cupy" >/dev/null 2>&1; then
          log "gpu extras already present (cudf + cupy importable)"
        else
          gpu_extras_install || true
        fi
      fi
      log "ready: $VENV_DIR + dependencies"
      ;;
    test|tests)
      shift
      bootstrap
      PYTHONPATH="$HERE" exec "$VENV_DIR/bin/pytest" "$@"
      ;;
    lint)
      shift
      bootstrap
      exec "$VENV_DIR/bin/ruff" check src/ tests/ "$@"
      ;;
    fmt|format)
      shift
      bootstrap
      "$VENV_DIR/bin/ruff" check --fix src/ tests/
      "$VENV_DIR/bin/ruff" format src/ tests/ 2>/dev/null || true
      ;;
    shell)
      bootstrap
      log "entering venv-activated subshell -- type 'exit' to leave"
      exec "${SHELL:-/bin/bash}" -i -c "
        source '$VENV_DIR/bin/activate'
        export PYTHONPATH='$HERE'
        exec '${SHELL:-/bin/bash}' -i
      "
      ;;
    clean)
      log "removing $VENV_DIR, .pytest_cache, .ruff_cache, **/__pycache__"
      rm -rf "$VENV_DIR" .pytest_cache .ruff_cache .mypy_cache
      find . -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
      ;;
    help|-h|--help)
      show_help
      ;;
    *)
      run_cli "$@"
      ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
